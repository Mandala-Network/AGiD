# =============================================================================
# AGIdentity Gateway - Environment Variables
# =============================================================================
# Copy this file to .env and fill in required values.
# Variables with (optional) have sensible defaults and can be omitted.
# =============================================================================

# ---- Identity & Wallet ----

# Agent private key -- 64-character hex string (required)
# Generate with: openssl rand -hex 32
AGENT_PRIVATE_KEY=

# Network: "mainnet" or "testnet" (optional, default: mainnet)
# AGID_NETWORK=mainnet

# ---- LLM Provider ----

# Anthropic API key (required if using Anthropic Claude)
ANTHROPIC_API_KEY=

# LLM model override (optional)
# AGID_MODEL=claude-sonnet-4-5-20250929

# Alternative LLM providers (optional):
# AGID_LLM_PROVIDER=ollama
# AGID_LLM_BASE_URL=http://localhost:11434
# AGID_LLM_API_KEY=

# ---- Paths ----

# Workspace path for agent files (optional, default: ~/.agidentity/workspace/)
# AGID_WORKSPACE_PATH=

# Sessions path for conversation history (optional, default: ~/.agidentity/sessions/)
# AGID_SESSIONS_PATH=

# ---- NautilusBridge Integration ----

# Enable/disable bridge integration (optional, default: true)
# Set to "false" to run gateway without trading capabilities
# NAUTILUS_BRIDGE_ENABLED=true

# Bridge WebSocket URL (optional, default: ws://127.0.0.1:9500)
# BRIDGE_URL=ws://127.0.0.1:9500

# Degraded state timeout in milliseconds (optional, default: 300000 = 5 minutes)
# If bridge is unreachable for this duration, emergency halt is triggered
# BRIDGE_DEGRADED_TIMEOUT_MS=300000

# ---- Health & Networking ----

# Health check HTTP port (optional, default: 3000)
# HEALTH_PORT=3000

# MessageBox host URL (optional, default: https://messagebox.babbage.systems)
# MESSAGEBOX_HOST=https://messagebox.babbage.systems

# ---- Agent Behavior ----

# Disable emojis in agent responses (optional, default: not set)
# Set to "true" to inject a behavioral directive preventing emoji usage
# AGID_NO_EMOJIS=true

# ---- Identity Verification ----

# Comma-separated list of trusted certifier public keys (optional)
# TRUSTED_CERTIFIERS=

# Require valid certificates from trusted certifiers for all requests (optional)
# Set to "true" to reject uncertified senders
# AGID_REQUIRE_CERTS=false
